#!/usr/bin/env bash
# Smart paste: pick the right paste keystroke for the focused window.
# Terminals want shift+insert (ctrl+v is a literal control char to them).
# Everything else — browsers, GTK/Qt apps, Electron — wants ctrl+v.
#
# Called by voxtype-paste-watcher when voxtype completes a transcription
# (text is already on the clipboard).

set -u

# Match against the Hyprland window class. Add new terminal classes here
# when you install one. Match is exact / case-insensitive; partial match
# would be too aggressive (e.g. "ghostly-app" would falsely match).
TERMINAL_CLASSES=(
  "com.mitchellh.ghostty"
  "kitty"
  "Alacritty"
  "alacritty"
  "foot"
  "wezterm"
  "org.gnome.Console"
  "org.kde.konsole"
  "xterm"
  "URxvt"
)

active_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')
if [[ -z "$active_class" ]]; then
  # No focused window — bail silently. Better than typing into the wrong place.
  exit 0
fi

is_terminal=0
for cls in "${TERMINAL_CLASSES[@]}"; do
  if [[ "${active_class,,}" == "${cls,,}" ]]; then
    is_terminal=1
    break
  fi
done

# wtype key syntax: -M = modifier press, -m = modifier release,
# -P = key press (no release), -p = key release, -k = press+release atomic.
# We hold the modifier across an atomic key press+release, the same way a
# human would. Using -P here (press only) leaves the key held → kernel
# autorepeat kicks in and you get "vvvvv" in the browser, or stuck Insert
# in terminals.
if (( is_terminal )); then
  # shift+Insert — terminal paste (kitty/ghostty/alacritty/etc.)
  wtype -M shift -k Insert -m shift
else
  # ctrl+v — universal GUI paste
  wtype -M ctrl -k v -m ctrl
fi
