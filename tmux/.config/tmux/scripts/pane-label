#!/usr/bin/env bash

pane_pid="$1"
pane_command="$2"
pane_path="$3"
pane_title="$4"
label_mode="${5:-short}"

trim_path() {
  local path="$1"

  if [ "$label_mode" = "long" ]; then
    printf '%s\n' "$path" | rev | cut -d'/' -f-2 | rev
  else
    basename "$path"
  fi
}

shell_label() {
  trim_path "$pane_path"
}

# NOTE: ps-based process-tree detection was removed here. `ps --forest` wedges
# in uninterruptible D state under memory pressure and accumulates without
# bound. Agent detection now lives in agent-pane-label via pane_command +
# pane content. Keep this script ps-free.

case "$pane_command" in
  ssh)
    printf '%s\n' "${pane_title:-ssh}"
    ;;
  nvim|vim)
    printf 'nvim\n'
    ;;
  bash|zsh|fish|sh)
    shell_label
    ;;
  node)
    shell_label
    ;;
  claude|claude-code)
    printf 'claude:%s\n' "$(basename "$pane_path")"
    ;;
  codex)
    printf 'codex:%s\n' "$(basename "$pane_path")"
    ;;
  *)
    printf '%s\n' "$pane_command"
    ;;
esac
