#!/usr/bin/env python3
"""prefix+u: pick a URL, file path, or Claude Code [file] card from the visible
tmux pane and open it (xdg-open) or copy it (ctrl-y)."""
import subprocess, re, os, sys

cap = subprocess.run(['tmux', 'capture-pane', '-J', '-p', '-S', '-20000'],
                     capture_output=True, text=True).stdout
items, seen = [], set()
def add(x):
    x = x.strip().rstrip('.,;:)')
    if not x or x in seen:
        return
    if '\u2026' in x or '/../' in x or x.startswith('//'):
        return
    seen.add(x); items.append(x)

# 1. Claude Code file cards:  [file] <path> (<size>)  -- path may contain spaces
for m in re.finditer(r'\[file\]\s+(.+?)\s+\([\d.]+\s*[KMGT]?i?B\)', cap):
    add(m.group(1))
# 2. URLs
for m in re.finditer(r'(?:https?|ftp|file)://[^\s)>"\'`]+', cap):
    add(m.group(0))
# 3. bare paths (no spaces) ending in a known extension
for m in re.finditer(r'(?:~|/)[\w./~+-]+\.(?:pdf|html?|png|jpe?g|svg|md|txt|csv|json|log|tar|gz|zip)\b', cap):
    add(m.group(0))

if not items:
    subprocess.run(['tmux', 'display-message', 'url-open: no links or files on screen'])
    sys.exit(0)

r = subprocess.run(['fzf', '--no-sort', '--prompt=open > ',
                    '--header=enter = open     ctrl-y = copy', '--expect=ctrl-y'],
                   input='\n'.join(items), capture_output=True, text=True)
lines = r.stdout.splitlines()
if not lines:
    sys.exit(0)
key = lines[0]
sel = lines[1] if len(lines) > 1 else ''
if not sel:
    sys.exit(0)
target = os.path.expanduser(sel)
if key == 'ctrl-y':
    subprocess.run(['wl-copy'], input=sel, text=True)
    subprocess.run(['tmux', 'display-message', f'copied: {sel}'])
else:
    subprocess.Popen(['setsid', '-f', 'xdg-open', target],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['tmux', 'display-message', f'opening: {os.path.basename(sel)}'])
