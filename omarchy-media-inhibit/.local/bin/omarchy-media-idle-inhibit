#!/bin/bash
# Hold Omarchy's stay-awake state while media is ACTIVELY playing, so the
# screensaver/lock never kicks in mid-video or mid-meeting. Paused media is
# not held, so the machine still idles normally.
#
# Signal: `omarchy-shell media status` -> .playing  (the same MPRIS data the
# bar's media widget renders). Deliberately NOT audio-stream based: on this
# box speech-dispatcher and the SmartPBX softphone both hold permanently
# uncorked PipeWire streams, so "any active stream" would inhibit idle forever.
#
# Ownership: Omarchy gates idle on the presence of
# ~/.local/state/omarchy/indicators/stay-awake (see omarchy-toggle-idle, and
# the shell's plugins/services/idle/Service.qml, which watches that dir). We
# write a token into it and only ever release a file still carrying our token,
# mirroring what omarchy-update-stay-awake does. So we never clobber a manual
# "Stay Awake" toggle, and if you turn it off by hand while media is playing we
# back off until playback stops and restarts.

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy/indicators"
STATE_FILE="$STATE_DIR/stay-awake"
TOKEN="omarchy-media-idle-inhibit"
POLL="${OMARCHY_MEDIA_INHIBIT_POLL:-15}"

held=0
suppressed=0

log() { printf '%s omarchy-media-idle-inhibit: %s\n' "$(date -Is)" "$*"; }

is_playing() {
  local json
  # NOTE: do NOT pass -q here. In omarchy-shell, -q means "suppress output"
  # (best-effort mode), so `omarchy-shell -q media status` prints nothing and
  # this check would silently never fire.
  json=$(omarchy-shell media status 2>/dev/null) || return 1
  [[ -n $json ]] || return 1
  grep -qE '"playing"[[:space:]]*:[[:space:]]*true' <<<"$json"
}

# An active (uncorked) PipeWire CAPTURE stream means somebody has your mic open,
# i.e. you are in a call. This covers browser meetings (Teams, Zoho Meeting,
# Meet, Zoom-web), Electron apps (Zoho Cliq), and the SmartPBX softphone alike --
# it needs no per-app list, which is what a browser-binary allowlist got wrong:
# it silently missed Cliq.
#
# Measured 2026-08-18, before/during/after a real Teams meeting: the softphone,
# aftercalls and its parec helpers ALL released their capture streams when the
# meeting ended, despite the apps staying up -- so none of them are permanent
# and none need excluding. (speech-dispatcher only ever holds a PLAYBACK stream;
# this function reads source-outputs only, so it never sees it.)
#
# If some app ever does pin a capture stream open with no call in progress, add
# it here rather than reverting to an allowlist. The claim is logged with the
# offending stream name, so the journal will name the culprit.
#
# Pipe-separated LITERAL substrings, not a regex -- app names like
# "PipeWire ALSA [client]" contain brackets that awk would read as a character
# class, which silently fails to match (caught in fixture testing).
# Default ignores the SmartPBX softphone. Measured across a day: its capture
# stream is neither permanent nor call-bound -- it disappeared entirely after a
# meeting, then reappeared uncorked hours later with no call in progress. Left
# in, it pins stay-awake indefinitely and the machine never sleeps.
#
# TRADE-OFF, know this: an actual softphone PHONE CALL therefore does NOT hold
# idle open. Browser meetings (Teams, Zoho Meeting, Meet) and Cliq still do,
# because they are separate streams. If softphone calls need covering, they need
# a signal that distinguishes in-call from idle -- the PipeWire stream does not.
CAPTURE_IGNORE="${OMARCHY_MEDIA_INHIBIT_IGNORE:-PipeWire ALSA [client]}"

# An uncorked PipeWire PLAYBACK stream means sound is actually coming out, which
# is the ground truth MPRIS is not. Verified 2026-08-21: while a YouTube video was
# playing, `omarchy-shell media status` reported "playing":false yet Zen held an
# uncorked sink-input -- so the inhibitor released and the screensaver fired
# mid-video. The browser exposes ONE MPRIS session for all tabs and it does not
# reliably track which tab is actually making noise (see also the Zoho Mail chime
# that briefly hijacked it). omarchy's own media service does not trust MPRIS
# alone either -- media/Service.qml:81 playerHasPlaybackStream() correlates each
# player against Pipewire nodes -- but that is not exposed over IPC, so we do the
# equivalent here.
#
# Pipe-separated LITERAL substrings (not a regex -- app names contain brackets
# that awk would read as a character class). speech-dispatcher holds a
# permanently uncorked playback stream on this box and must stay excluded or idle
# is pinned forever. The triggering stream is logged, so if something new ever
# pins it the journal names the culprit.
PLAYBACK_IGNORE="${OMARCHY_MEDIA_INHIBIT_PLAYBACK_IGNORE:-speech-dispatcher}"

# Echoes the triggering stream description; exit 0 when sound is actually playing.
is_audible() {
  local hit
  hit=$(pactl list sink-inputs 2>/dev/null | awk -v ig="$PLAYBACK_IGNORE" '
    /^Sink Input/ { id=$3; corked=""; app=""; bin="" }
    /Corked:/                          { corked=$2 }
    /application\.name =/              { app=$0; sub(/.*= /,"",app); gsub(/"/,"",app) }
    /application\.process\.binary =/   { bin=$0; sub(/.*= /,"",bin); gsub(/"/,"",bin) }
    /^$/ {
      if (id != "" && corked == "no") {
        label = app; if (label == "") label = bin; if (label == "") label = id
        ignored = 0
        if (ig != "") {
          n = split(ig, pats, "|")
          for (i = 1; i <= n; i++)
            if (pats[i] != "" && index(label, pats[i]) > 0) { ignored = 1; break }
        }
        if (!ignored) { print label; exit }
      }
      id=""
    }
  ')
  [[ -n $hit ]] || return 1
  printf '%s\n' "$hit"
}

# Echoes the triggering stream description; exit 0 when a mic is live.
in_call() {
  local hit
  hit=$(pactl list source-outputs 2>/dev/null | awk -v ig="$CAPTURE_IGNORE" '
    /^Source Output/ { id=$3; corked=""; app=""; bin="" }
    /Corked:/                          { corked=$2 }
    /application\.name =/              { app=$0; sub(/.*= /,"",app); gsub(/"/,"",app) }
    /application\.process\.binary =/   { bin=$0; sub(/.*= /,"",bin); gsub(/"/,"",bin) }
    /^$/ {
      if (id != "" && corked == "no") {
        label = app; if (label == "") label = bin; if (label == "") label = id
        ignored = 0
        if (ig != "") {
          n = split(ig, pats, "|")
          for (i = 1; i <= n; i++)
            if (pats[i] != "" && index(label, pats[i]) > 0) { ignored = 1; break }
        }
        if (!ignored) { print label; exit }
      }
      id=""
    }
  ')
  [[ -n $hit ]] || return 1
  printf '%s\n' "$hit"
}

we_own_it() {
  [[ -f $STATE_FILE ]] || return 1
  [[ "$(cat "$STATE_FILE" 2>/dev/null)" == "$TOKEN" ]]
}

claim() {
  mkdir -p "$STATE_DIR"
  omarchy-toggle-idle stay-awake >/dev/null 2>&1 || return 1
  printf '%s\n' "$TOKEN" >"$STATE_FILE"
  log "holding stay-awake ($1)"
}

release() {
  omarchy-toggle-idle allow-idle >/dev/null 2>&1 || true
  log "media stopped and no call -> released stay-awake"
}

cleanup() {
  if (( held )) && we_own_it; then release; fi
  exit 0
}
trap cleanup TERM INT HUP

log "started (poll=${POLL}s)"

while :; do
  # Resolve the reason once per tick so the journal always names what held it.
  hold_reason=""
  if is_playing; then
    hold_reason="media playing"
  elif snd=$(is_audible); then
    # MPRIS is unreliable (see is_audible), so audible output counts on its own.
    hold_reason="audio out: $snd"
  elif mic=$(in_call); then
    hold_reason="mic active: $mic"
  fi

  if [[ -n $hold_reason ]]; then
    # Our claim vanished or was replaced while media kept playing -> the user
    # (or another owner) took over. Back off rather than fight the toggle.
    if (( held )) && ! we_own_it; then
      log "claim was cleared externally -> backing off until media/call restarts"
      held=0
      suppressed=1
    fi

    if (( ! held && ! suppressed )); then
      if [[ ! -f $STATE_FILE ]]; then
        claim "$hold_reason" && held=1
      fi
      # If the file exists but isn't ours, stay-awake is already on manually.
      # Nothing to do, and nothing to release later.
    fi
  else
    suppressed=0
    if (( held )); then
      we_own_it && release
      held=0
    fi
  fi

  sleep "$POLL"
done
