#!/usr/bin/env python3
"""to-hq "<message>": hand a piece of Clayton's request to HQ, which files and dispatches it.

Use it when Clayton's (often dictated) message contains something outside your own task: new build work, another
customer/ticket, another repo. Include his words and the context you have.

It never types into Clayton's HQ chat. The handoff is written to /root/hq/inbox/ and the "HQ intake" automation
runs at once in its own short-lived tab to file the issue and start the work.
"""
import datetime, json, os, secrets, subprocess, sys

INBOX = "/root/hq/inbox"
INTAKE = "HQ intake"
msg = " ".join(sys.argv[1:]).strip() or sys.stdin.read().strip()
if not msg:
    sys.exit("usage: to-hq \"<what Clayton asked, his words, and the context you have>\"")
os.makedirs(INBOX, exist_ok=True)
stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
path = os.path.join(INBOX, f"{stamp}-{secrets.token_hex(3)}.md")
src = os.environ.get("ORCA_WORKTREE_ID", os.getcwd())
with open(path + ".tmp", "w") as f:
    f.write(f"from: {src}\nsession: {os.environ.get('CLAUDE_SESSION_ID', '')}\nat: {stamp}\n\n{msg}\n")
os.rename(path + ".tmp", path)  # atomic: intake never sees a half-written file
autos = json.loads(subprocess.run(["orca", "automations", "list", "--json"], capture_output=True, text=True).stdout)
ids = [a["id"] for a in autos["result"]["automations"] if a.get("name") == INTAKE]
if ids:
    subprocess.run(["orca", "automations", "run", ids[0], "--json"], capture_output=True)
print(f"handed to HQ ({os.path.basename(path)})")
