#!/usr/bin/env python3
"""clayton-ask: file asks for Clayton (decisions, info, actions) into one GitHub queue.

  clayton-ask file --kind Decision|Info|Action --title "..." [--body "..."] [--repo owner/repo]
  clayton-ask hook            # Claude Code Stop hook: reads hook JSON on stdin
  clayton-ask list            # open asks across every repo
  clayton-ask push --title T --message M [--url U]   # phone notification via Home Assistant

Each ask becomes one issue labelled `ask:clayton`, assigned to Clayton, title prefixed
[Decision]/[Info]/[Action]. Re-filing the same ask is a no-op (dedupe marker in the body).
When run inside an Orca terminal, the card gets the unread dot and a "waiting on Clayton" comment.
Design: vault `30 Resources/Apps/Orca Playbook.md`, Rule 6.
"""
import argparse, hashlib, json, os, re, subprocess, sys, urllib.request

ASSIGNEE = "smartpbx"
LABEL = "ask:clayton"
FALLBACK_REPO = "smartpbx/patchbay"
NEEDS_YOU = "status-5"  # Orca board column "Needs you" (id assigned by the desktop when the column was added)
KINDS = ("Decision", "Info", "Action")
BLOCK_RE = re.compile(r"^\s*\**NEEDS-CLAYTON\**\s*:?\s*$", re.M)
LINE_RE = re.compile(r"^\s*(?:[-*]|\d+[.)])\s*\[(Decision|Info|Action)\]\s*(.+?)\s*$", re.I)
LOG = os.path.expanduser("~/.claude/clayton-ask.log")
PUSH_ENV = os.path.expanduser("~/.config/clayton-ask/env")  # HA_URL, HA_TOKEN, HA_NOTIFY (mode 0600)


def log(msg):
    with open(LOG, "a") as f:
        f.write(msg.rstrip() + "\n")


def run(*cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode:
        raise RuntimeError(f"{' '.join(cmd[:3])}: {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def repo_for(cwd):
    try:
        url = run("git", "-C", cwd, "remote", "get-url", "origin")
    except Exception:
        return FALLBACK_REPO
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else FALLBACK_REPO


def issues_repo(repo):
    """Repos with issues disabled (forks like smartpbx/fspbx) file into the fallback repo."""
    ok = run("gh", "repo", "view", repo, "--json", "hasIssuesEnabled", "-q", ".hasIssuesEnabled", check=False)
    return repo if ok == "true" else FALLBACK_REPO


def push(title, message, url=None):
    """Phone notification via Home Assistant. Silently skipped when not configured."""
    if not os.path.exists(PUSH_ENV):
        return False
    env = dict(l.strip().split("=", 1) for l in open(PUSH_ENV) if "=" in l and not l.startswith("#"))
    data = {"title": title, "message": message}
    if url:
        data["data"] = {"clickAction": url, "url": url}
    req = urllib.request.Request(f"{env['HA_URL'].rstrip('/')}/api/services/notify/{env['HA_NOTIFY']}",
                                 data=json.dumps(data).encode(), method="POST",
                                 headers={"Authorization": f"Bearer {env['HA_TOKEN']}", "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=10)
        return True
    except Exception as e:
        log(f"push failed: {e}")
        return False


def ask_key(kind, title):
    norm = re.sub(r"\W+", " ", title.lower()).strip()
    return hashlib.sha1(f"{kind}|{norm}".encode()).hexdigest()[:12]


def ensure_label(repo):
    run("gh", "label", "create", LABEL, "-R", repo, "--color", "FBCA04",
        "--description", "Waiting on Clayton: decision, info or action", check=False)


def file_ask(kind, title, body, repo, context=""):
    kind = kind.capitalize()
    if kind not in KINDS:
        raise ValueError(f"kind must be one of {KINDS}")
    target = issues_repo(repo)
    if target != repo:
        context = f"Concerns `{repo}` (issues disabled there).\n\n{context}"
        repo = target
    title = title.strip().rstrip(".")
    key = ask_key(kind, title)
    marker = f"<!-- ask-key: {key} -->"
    open_asks = run("gh", "issue", "list", "-R", repo, "--label", LABEL, "--state", "open",
                    "--limit", "500", "--json", "url,body", check=False)
    for issue in json.loads(open_asks or "[]"):
        if marker in (issue.get("body") or ""):
            return issue["url"], False
    ensure_label(repo)
    short = title if len(title) <= 90 else title[:87] + "..."
    text = f"{body.strip()}\n\n{context.strip()}\n\n{marker}".strip()
    url = run("gh", "issue", "create", "-R", repo, "--title", f"[{kind}] {short}",
              "--label", LABEL, "--assignee", ASSIGNEE, "--body", text)
    return url, True


def orca_flag(title):
    wt = os.environ.get("ORCA_WORKTREE_ID")
    if not wt:
        return
    args = ["orca", "worktree", "set", "--worktree", f"id:{wt}", "--unread",
            "--comment", f"⏸ waiting on Clayton: {title[:80]}", "--json"]
    if not wt.endswith("/hq/HQ"):  # HQ's own asks don't move HQ's card
        args[-1:-1] = ["--workspace-status", NEEDS_YOU]
    run(*args, check=False)


def last_assistant_text(transcript):
    text = ""
    with open(transcript, errors="ignore") as f:
        for line in f:
            try:
                j = json.loads(line)
            except json.JSONDecodeError:
                continue
            if j.get("type") != "assistant":
                continue
            parts = [c.get("text", "") for c in j.get("message", {}).get("content", [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            if parts:
                text = "\n".join(parts)
    return text


def parse_block(text):
    m = None
    for m in BLOCK_RE.finditer(text):
        pass  # use the last block in the message
    if not m:
        return []
    asks = []
    for line in text[m.end():].splitlines():
        if not line.strip():
            if asks:
                break
            continue
        lm = LINE_RE.match(line)
        if lm:
            asks.append((lm.group(1).capitalize(), lm.group(2)))
        elif asks and line.startswith(("  ", "\t")):
            k, t = asks[-1]
            asks[-1] = (k, t + " " + line.strip())
        else:
            break
    return asks


def cmd_hook():
    data = json.load(sys.stdin)
    if data.get("stop_hook_active"):
        return
    text = data.get("last_assistant_message") or ""
    if not text and data.get("transcript_path"):
        text = last_assistant_text(data["transcript_path"])
    asks = parse_block(text)
    if not asks:
        return
    if os.fork():  # never hold up the agent: file in the background
        return
    os.setsid()
    cwd = data.get("cwd") or os.getcwd()
    repo = repo_for(cwd)
    ctx = (f"---\nAsked by an agent session `{data.get('session_id')}` in `{cwd}`"
           + (f" (Orca workspace `{os.environ['ORCA_WORKTREE_ID']}`)" if os.environ.get("ORCA_WORKTREE_ID") else "")
           + f".\n\n<details><summary>Agent's message</summary>\n\n{text[-3000:]}\n\n</details>")
    urgent = []
    for kind, line in asks:
        title = re.split(r"\s+[—-]\s+blocks\b", line)[0]
        try:
            url, new = file_ask(kind, title, f"**{kind}:** {line}", repo, ctx)
            log(f"{'filed' if new else 'exists'} {url} {kind}: {title}")
            if new and kind in ("Decision", "Action"):
                urgent.append((kind, title, url))
        except Exception as e:
            log(f"FAILED {repo} {kind}: {title}: {e}")
    orca_flag(asks[0][1])
    if urgent:
        where = os.environ.get("ORCA_WORKTREE_ID", cwd).split("::")[-1].rstrip("/").split("/")[-1]
        msg = "\n".join(f"[{k}] {t[:90]}" for k, t, _ in urgent)
        push(f"Agent waiting on you ({where})" if len(urgent) == 1 else f"{len(urgent)} asks waiting ({where})",
             msg, urgent[0][2])


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("file")
    f.add_argument("--kind", required=True)
    f.add_argument("--title", required=True)
    f.add_argument("--body", default="")
    f.add_argument("--repo")
    sub.add_parser("hook")
    sub.add_parser("list")
    pp = sub.add_parser("push")
    pp.add_argument("--title", required=True)
    pp.add_argument("--message", required=True)
    pp.add_argument("--url")
    a = p.parse_args()
    if a.cmd == "hook":
        try:
            cmd_hook()
        except Exception as e:
            log(f"hook error: {e}")
        return
    if a.cmd == "push":
        print("sent" if push(a.title, a.message, a.url) else "not sent (see log / config)")
        return
    if a.cmd == "list":
        print(run("gh", "search", "issues", "--assignee", ASSIGNEE, "--label", LABEL, "--state", "open",
                  "--sort", "created", "--order", "asc", "--limit", "200"))
        return
    url, new = file_ask(a.kind, a.title, a.body or a.title, a.repo or repo_for(os.getcwd()))
    print(("filed " if new else "already open ") + url)
    orca_flag(a.title)


if __name__ == "__main__":
    main()
