#!/usr/bin/env python3
"""clayton-ask: file asks for Clayton (decisions, info, actions) into one GitHub queue.

  clayton-ask file --kind Decision|Info|Action --title "..." [--body "..."] [--repo owner/repo]
  clayton-ask hook            # Claude Code Stop hook: reads hook JSON on stdin
  clayton-ask answered        # UserPromptSubmit hook: Clayton replied, card leaves Needs you
  clayton-ask list            # open asks across every repo
  clayton-ask promote         # (timer) surface parked "after X" asks whose PR/issue has closed
  clayton-ask sweep           # (timer) take cards out of Needs you with no live agent or no open asks
  clayton-ask push --title T --message M [--url U]   # phone notification via Home Assistant

Each ask becomes one issue labelled `ask:clayton`, assigned to Clayton, title prefixed
[Decision]/[Info]/[Action]. Re-filing the same ask is a no-op (dedupe marker in the body).
When run inside an Orca terminal, the card gets the unread dot and a "waiting on Clayton" comment.
Design: vault `30 Resources/Apps/Orca Playbook.md`, Rule 6.
"""
import argparse, difflib, glob, hashlib, json, os, re, subprocess, sys, time, urllib.request

ASSIGNEE = "smartpbx"
LABEL = "ask:clayton"
LATER = "ask:later"  # parked until the PR/issue it waits for closes; `clayton-ask promote` surfaces it
FALLBACK_REPO = "smartpbx/patchbay"
NEEDS_YOU = "status-5"  # Orca board column "Needs you" (id assigned by the desktop when the column was added)
KINDS = ("Decision", "Info", "Action")
BLOCK_RE = re.compile(r"^\s*\**NEEDS-CLAYTON\**\s*:?\s*$", re.M)
LINE_RE = re.compile(r"^\s*(?:[-*]|\d+[.)])\s*\[(Decision|Info|Action)(?:\s*,\s*after\s+([\w./-]*#\d+))?\]\s*(.+?)\s*$", re.I)
LOG = os.path.expanduser("~/.claude/clayton-ask.log")
RULES_VERSION = os.path.expanduser("~/.claude/rules-version")  # bump this file's content when the global rules change
SEEN_DIR = "/tmp/clayton-rules-seen"
ANSWERED_DIR = "/tmp/clayton-answered"  # mtime = when Clayton last replied in a workspace
PUSH_ENV = os.path.expanduser("~/.config/clayton-ask/env")  # HA_URL, HA_TOKEN, HA_NOTIFY (mode 0600)


def log(msg):
    with open(LOG, "a") as f:
        f.write(msg.rstrip() + "\n")


def run(*cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode:
        raise RuntimeError(f"{' '.join(cmd[:3])}: {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def repo_for(cwd):
    try:
        url = run("git", "-C", cwd, "remote", "get-url", "origin")
    except Exception:
        return FALLBACK_REPO
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else FALLBACK_REPO


def issues_repo(repo):
    """Repos with issues disabled (forks like smartpbx/fspbx) file into the fallback repo."""
    ok = run("gh", "repo", "view", repo, "--json", "hasIssuesEnabled", "-q", ".hasIssuesEnabled", check=False)
    return repo if ok == "true" else FALLBACK_REPO


def push(title, message, url=None):
    """Phone notification via Home Assistant. Silently skipped when not configured."""
    if not os.path.exists(PUSH_ENV):
        return False
    env = dict(l.strip().split("=", 1) for l in open(PUSH_ENV) if "=" in l and not l.startswith("#"))
    data = {"title": title, "message": message}
    if url:
        data["data"] = {"clickAction": url, "url": url}
    req = urllib.request.Request(f"{env['HA_URL'].rstrip('/')}/api/services/notify/{env['HA_NOTIFY']}",
                                 data=json.dumps(data).encode(), method="POST",
                                 headers={"Authorization": f"Bearer {env['HA_TOKEN']}", "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=10)
        log(f"pushed: {title} | {message[:120]}")
        return True
    except Exception as e:
        log(f"push failed: {e}")
        return False


def full_ref(ref, repo):
    """'#12' -> repo#12, 'patchbay#12' -> smartpbx/patchbay#12, 'org/repo#12' unchanged."""
    name, num = ref.split("#", 1)
    if not name:
        return f"{repo}#{num}"
    if "/" not in name:
        return f"{repo.split('/')[0]}/{name}#{num}"
    return ref


def ask_key(kind, title):
    norm = re.sub(r"\W+", " ", title.lower()).strip()
    return hashlib.sha1(f"{kind}|{norm}".encode()).hexdigest()[:12]


REF_RE = re.compile(r"[A-Za-z][\w-]*#\d+|#\d+|C-\d{4,5}|\b\d{4,6}\b")
STOP = set("the a an to of and or for on in is it be with this that at by from as our your you we".split())


def refs(text):
    return {r.lower().lstrip("#") if r.startswith("#") else r.lower() for r in REF_RE.findall(text)}


def words(text):
    return {w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in STOP and len(w) > 2}


def same_ask(kind, title, other_title):
    """True when an open ask already covers this one. Agents re-list open asks every reply, reworded."""
    m = re.match(r"\[(\w+)\]\s*(.*)", other_title)
    if not m or m.group(1).capitalize() != kind:
        return False
    other = m.group(2)
    if difflib.SequenceMatcher(None, title.lower(), other.lower()).ratio() >= 0.6:
        return True
    a, b = words(title), words(other)
    overlap = len(a & b) / max(1, min(len(a), len(b)))
    return bool(refs(title) & refs(other)) and overlap >= 0.4


def ensure_label(repo):
    run("gh", "label", "create", LABEL, "-R", repo, "--color", "FBCA04",
        "--description", "Waiting on Clayton: decision, info or action", check=False)


def file_ask(kind, title, body, repo, context="", after=None):
    kind = kind.capitalize()
    if kind not in KINDS:
        raise ValueError(f"kind must be one of {KINDS}")
    target = issues_repo(repo)
    if target != repo:
        context = f"Concerns `{repo}` (issues disabled there).\n\n{context}"
        repo = target
    title = title.strip().rstrip(".")
    key = ask_key(kind, title)
    marker = f"<!-- ask-key: {key} -->"
    open_asks = [i for lab in (LABEL, LATER) for i in json.loads(
        run("gh", "issue", "list", "-R", repo, "--label", lab, "--state", "open",
            "--limit", "500", "--json", "url,body,title,number", check=False) or "[]")]
    for issue in open_asks:
        if marker in (issue.get("body") or "") or same_ask(kind, title, issue.get("title") or ""):
            return issue["url"], False
        if re.search(rf"(?<![\w-])#{issue['number']}\b", title):  # the line points at an open ask: not a new one
            return issue["url"], False
    ensure_label(repo)
    label = LABEL
    if after:
        ref = full_ref(after, repo)
        marker += f"\n<!-- waits-for: {ref} -->"
        context = f"**Parked until {ref} closes.** It reaches Clayton (push + Needs you) then, not before.\n\n{context}"
        run("gh", "label", "create", LATER, "-R", repo, "--color", "C5DEF5",
            "--description", "Ask for Clayton, parked until the PR/issue it waits for closes", check=False)
        label = LATER
    short = title if len(title) <= 90 else title[:87] + "..."
    text = f"{body.strip()}\n\n{context.strip()}\n\n{marker}".strip()
    url = run("gh", "issue", "create", "-R", repo, "--title", f"[{kind}] {short}",
              "--label", label, "--assignee", ASSIGNEE, "--body", text)
    return url, True


def answered_marker(wt):
    return os.path.join(ANSWERED_DIR, hashlib.sha1(wt.encode()).hexdigest()[:16])


def orca_flag(title, since=None):
    wt = os.environ.get("ORCA_WORKTREE_ID")
    if not wt:
        return
    marker = answered_marker(wt)
    if since and os.path.exists(marker) and os.path.getmtime(marker) > since:
        log(f"not flagging {wt}: Clayton replied after this turn ended")
        return
    args = ["orca", "worktree", "set", "--worktree", f"id:{wt}", "--unread",
            "--comment", f"⏸ waiting on Clayton: {title[:80]}", "--json"]
    if not wt.endswith("/hq/HQ"):  # HQ's own asks don't move HQ's card
        args[-1:-1] = ["--workspace-status", NEEDS_YOU]
    run(*args, check=False)


def emit_context(parts):
    if parts:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                                 "additionalContext": "\n\n".join(parts)}}))
        sys.stdout.flush()


def cmd_answered():
    """UserPromptSubmit hook: Clayton replied in this workspace.

    If the card is in Needs you: remind the agent which of its asks are still open (so it closes the ones he just
    answered, even in sessions started before that rule existed), and move the card back to In progress.
    """
    data = json.loads(sys.stdin.read() or "{}")
    context = []
    # Once per session per rules version: tell already-running agents the global rules changed.
    if os.path.exists(RULES_VERSION):
        ver = open(RULES_VERSION).read().strip()
        seen = os.path.join(SEEN_DIR, f"{data.get('session_id', 'x')}-{ver}")
        if not os.path.exists(seen):
            os.makedirs(SEEN_DIR, exist_ok=True)
            open(seen, "w").close()
            context.append(f"Clayton's global rules changed ({ver}). Before answering, re-read ~/.claude/CLAUDE.md "
                           "(at least the 'Clayton talks in whole thoughts' and 'Asks for Clayton' sections) and follow "
                           "the current version from now on.")
    wt = os.environ.get("ORCA_WORKTREE_ID")
    if wt:
        os.makedirs(ANSWERED_DIR, exist_ok=True)
        open(answered_marker(wt), "w").close()  # a still-running Stop hook won't re-flag the card
    if not wt or wt.endswith("/hq/HQ"):
        emit_context(context)
        return
    show = json.loads(run("orca", "worktree", "show", "--worktree", f"id:{wt}", "--json", check=False) or "{}")
    if ((show.get("result") or {}).get("worktree") or {}).get("workspaceStatus") != NEEDS_YOU:
        emit_context(context)
        return
    found = run("gh", "search", "issues", "--assignee", ASSIGNEE, "--label", LABEL, "--state", "open",
                "--limit", "300", "--json", "number,title,repository,body", check=False)
    sid = data.get("session_id") or "-"
    mine = [i for i in json.loads(found or "[]") if f"session `{sid}`" in (i.get("body") or "")]
    if mine:
        lines = "\n".join(f"- {i['repository']['nameWithOwner']}#{i['number']}: {i['title']}" for i in mine)
        context.append("(Background, don't recite it.) Open asks this session filed earlier, some possibly about older "
                       "topics:\n" + lines + "\nOnly if his message answers one of these: act on it and close it with "
                       "gh issue close <n> -R <repo> -c 'Clayton: <short answer>'. Do NOT list these back to him; they "
                       "are already in his HQ queue. If he asks what's left, answer about your current task and at most "
                       "say how many older asks are waiting in HQ.")
    emit_context(context)
    if os.fork():
        return
    os.setsid()
    run("orca", "worktree", "set", "--worktree", f"id:{wt}", "--workspace-status", "in-progress", "--read",
        "--comment", "▶ Clayton replied; agent working", "--json", check=False)
    log(f"answered: {wt} out of Needs you ({len(mine)} open asks reminded)")


def cmd_promote():
    """Surface parked asks whose PR/issue has closed: relabel, push, move the card to Needs you."""
    found = run("gh", "search", "issues", "--assignee", ASSIGNEE, "--label", LATER, "--state", "open",
                "--limit", "200", "--json", "number,title,repository,body,url", check=False)
    for i in json.loads(found or "[]"):
        m = re.search(r"<!-- waits-for: ([\w.-]+/[\w.-]+)#(\d+) -->", i.get("body") or "")
        if not m:
            continue
        state = run("gh", "issue", "view", m.group(2), "-R", m.group(1), "--json", "state", "-q", ".state", check=False)
        if state not in ("CLOSED", "MERGED"):
            continue
        repo = i["repository"]["nameWithOwner"]
        run("gh", "issue", "edit", str(i["number"]), "-R", repo, "--add-label", LABEL, "--remove-label", LATER, check=False)
        run("gh", "issue", "comment", str(i["number"]), "-R", repo, "--body",
            f"{m.group(1)}#{m.group(2)} is now closed, so this is ready for Clayton.", check=False)
        push("Ready for you now", f"{i['title'][:110]}", i["url"])
        w = re.search(r"Orca workspace `([^`]+)`", i.get("body") or "")
        if w and not w.group(1).endswith("/hq/HQ"):
            run("orca", "worktree", "set", "--worktree", f"id:{w.group(1)}", "--workspace-status", NEEDS_YOU, "--unread",
                "--comment", f"⏸ ready now: {i['title'][:70]}", "--json", check=False)
        log(f"promoted {i['url']} ({m.group(1)}#{m.group(2)} closed)")


def cmd_sweep():
    """Needs you is for live agents waiting on Clayton. Move cards out that have no live agent or no open asks left.

    Asks from closed chats stay in HQ's inbox; answering them there resumes the chat.
    """
    ps = json.loads(run("orca", "worktree", "ps", "--json", check=False) or "{}")
    cards = [w for w in (ps.get("result") or {}).get("worktrees", []) if w.get("workspaceStatus") == NEEDS_YOU]
    if not cards:
        return
    found = run("gh", "search", "issues", "--assignee", ASSIGNEE, "--label", LABEL, "--state", "open",
                "--limit", "300", "--json", "body", check=False)
    bodies = [i.get("body") or "" for i in json.loads(found or "[]")]
    live = set()  # session ids of running Claude processes
    for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            sj = json.load(open(f))
            if os.path.exists(f"/proc/{sj['pid']}"):
                live.add(sj.get("sessionId"))
        except Exception:
            pass
    for w in cards:
        wt = w["worktreeId"]
        here = [b for b in bodies if f"`{wt}`" in b]
        waiting = [b for b in here if any(f"session `{x}`" in b for x in live if x)]
        if waiting:
            continue
        n = len(here)
        note = (f"{n} ask{'s' if n != 1 else ''} from closed chats in HQ's inbox" if n else "asks answered")
        run("orca", "worktree", "set", "--worktree", f"id:{wt}", "--workspace-status", "in-progress", "--read",
            "--comment", note, "--json", check=False)
        log(f"swept {wt} out of Needs you: {note}")


def last_assistant_text(transcript):
    text = ""
    with open(transcript, errors="ignore") as f:
        for line in f:
            try:
                j = json.loads(line)
            except json.JSONDecodeError:
                continue
            if j.get("type") != "assistant":
                continue
            parts = [c.get("text", "") for c in j.get("message", {}).get("content", [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            if parts:
                text = "\n".join(parts)
    return text


def parse_block(text):
    m = None
    for m in BLOCK_RE.finditer(text):
        pass  # use the last block in the message
    if not m:
        return []
    asks = []
    for line in text[m.end():].splitlines():
        if not line.strip():
            if asks:
                break
            continue
        lm = LINE_RE.match(line)
        if lm:
            asks.append((lm.group(1).capitalize(), lm.group(3), lm.group(2)))
        elif asks and line.startswith(("  ", "\t")):
            k, t, af = asks[-1]
            asks[-1] = (k, t + " " + line.strip(), af)
        else:
            break
    return asks


def cmd_hook():
    data = json.load(sys.stdin)
    if data.get("stop_hook_active"):
        return
    stopped_at = time.time()
    text = data.get("last_assistant_message") or ""
    if not text and data.get("transcript_path"):
        text = last_assistant_text(data["transcript_path"])
    asks = parse_block(text)
    if not asks:
        return
    if os.fork():  # never hold up the agent: file in the background
        return
    os.setsid()
    cwd = data.get("cwd") or os.getcwd()
    repo = repo_for(cwd)
    ctx = (f"---\nAsked by an agent session `{data.get('session_id')}` in `{cwd}`"
           + (f" (Orca workspace `{os.environ['ORCA_WORKTREE_ID']}`)" if os.environ.get("ORCA_WORKTREE_ID") else "")
           + f".\n\n<details><summary>Agent's message</summary>\n\n{text[-3000:]}\n\n</details>")
    urgent, now = [], [a for a in asks if not a[2]]
    for kind, line, after in asks:
        title = re.split(r"\s+[—-]\s+blocks\b", line)[0]
        try:
            url, new = file_ask(kind, title, f"**{kind}:** {line}", repo, ctx, after)
            log(f"{'filed' if new else 'exists'}{' (parked after ' + after + ')' if after else ''} {url} {kind}: {title}")
            if new and kind in ("Decision", "Action") and not after:
                urgent.append((kind, title, url))
        except Exception as e:
            log(f"FAILED {repo} {kind}: {title}: {e}")
    if now:
        orca_flag(now[0][1], since=stopped_at)
    if urgent:
        where = os.environ.get("ORCA_WORKTREE_ID", cwd).split("::")[-1].rstrip("/").split("/")[-1]
        msg = "\n".join(f"[{k}] {t[:90]}" for k, t, _ in urgent)
        push(f"Agent waiting on you ({where})" if len(urgent) == 1 else f"{len(urgent)} asks waiting ({where})",
             msg, urgent[0][2])


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("file")
    f.add_argument("--kind", required=True)
    f.add_argument("--title", required=True)
    f.add_argument("--body", default="")
    f.add_argument("--repo")
    f.add_argument("--after", help="park until this PR/issue closes, e.g. smartpbx/patchbay#1949 or #1949")
    sub.add_parser("hook")
    sub.add_parser("answered")
    sub.add_parser("promote")
    sub.add_parser("sweep")
    sub.add_parser("list")
    pp = sub.add_parser("push")
    pp.add_argument("--title", required=True)
    pp.add_argument("--message", required=True)
    pp.add_argument("--url")
    a = p.parse_args()
    if a.cmd == "hook":
        try:
            cmd_hook()
        except Exception as e:
            log(f"hook error: {e}")
        return
    if a.cmd == "promote":
        cmd_promote()
        return
    if a.cmd == "sweep":
        cmd_sweep()
        return
    if a.cmd == "answered":
        try:
            cmd_answered()
        except Exception as e:
            log(f"answered error: {e}")
        return
    if a.cmd == "push":
        print("sent" if push(a.title, a.message, a.url) else "not sent (see log / config)")
        return
    if a.cmd == "list":
        print(run("gh", "search", "issues", "--assignee", ASSIGNEE, "--label", LABEL, "--state", "open",
                  "--sort", "created", "--order", "asc", "--limit", "200"))
        return
    url, new = file_ask(a.kind, a.title, a.body or a.title, a.repo or repo_for(os.getcwd()), after=a.after)
    print(("filed " if new else "already open ") + url + (f" (parked until {a.after} closes)" if a.after else ""))
    if not a.after:
        orca_flag(a.title)


if __name__ == "__main__":
    main()
