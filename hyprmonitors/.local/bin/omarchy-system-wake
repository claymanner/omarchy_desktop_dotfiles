#!/bin/bash

# ============================================================================
#  TEMPORARY WORKAROUND -- DELETE ME once aquamarine >= 0.15.0 is installed.
#  See "HOW TO REMOVE" at the bottom. It self-reports once obsolete.
# ============================================================================
#
# omarchy:summary=Wake displays, then repair DP-4 if the mgpu swapchain bug hit
# omarchy:group=system
# omarchy:hidden=true
#
# PATH shadow for the packaged omarchy-system-wake (~/.local/bin precedes
# /usr/share/omarchy/bin). Runs the real one, then repairs DP-4 if needed.
#
# ---------------------------------------------------------------- THE BUG
# DP-4 is the only output on the Intel iGPU (card0/i915); everything renders on
# the NVIDIA 3080 (card1). Its frames are cross-GPU copies needing LINEAR source
# buffers. aquamarine's CSwapchain::resize() omitted `.multigpu` when acquiring
# buffers while fullReconfigure() includes it, so after a DPMS off/on the flag is
# lost, buffers come back non-linear, and the iGPU cannot scan out NVIDIA-tiled
# memory: signal present, solid black, while hyprctl reports it perfectly healthy.
# Fixed upstream 2026-08-15 by aquamarine 639ee4cd (#356), unreleased as of
# 2026-08-19 (latest tag v0.14.0; Arch extra ships 0.14.0-2).
#
# Repair: resize() is taken when size AND format both match, so only a format
# change routes through fullReconfigure(). bitdepth 8 -> 10 -> 8 forces two good
# reallocations and ends at the native format. Everything that preserves the
# format (output disable/enable, per-output DPMS, force_renderer_reload, moving
# windows, refresh-shell) provably does NOT work -- do not re-add them. A bare
# mode change is HARMFUL: an unsupported mode drops Hyprland to 640x480 and
# strands a stale framebuffer in the corner of the raster.
#
# --------------------------------------------------------------- LOGGING
# v1 logged to stderr, which quickshell's Process discards. On 2026-08-20 the
# session froze shortly after a wake and there was NO record of whether this had
# flipped or skipped -- the frozen Hyprland log lives in /run (tmpfs) and was
# wiped on restart. That made the helper unfalsifiable, so it was disabled.
# This version logs every decision and every step, before and after each hyprctl
# call, to BOTH a persistent file and the journal (`logger`), unbuffered. If it
# ever wedges the compositor again, the last line written names exactly where.
#     tail -f ~/.local/state/omarchy/dp4-fix.log
#     journalctl --user -t omarchy-dp4-fix --since today
#
# --------------------------------------------------------------- SAFETY
#   * flock: never two instances at once (wake can fire repeatedly).
#   * settle delay before touching the GPU, so we are not poking the mgpu path
#     in the middle of the compositor's own wake handling.
#   * kill switch: `touch ~/.local/state/omarchy/dp4-fix.off` disables it with no
#     edit and no relog. OMARCHY_DP4_FIX=0 also disables; =force repairs always.
#
# ------------------------------------------------------------ HOW TO REMOVE
#   cd ~/omarchy_desktop_dotfiles
#   git rm hyprmonitors/.local/bin/omarchy-system-wake
#   rm -f ~/.local/bin/omarchy-system-wake
#   git commit -m "Drop DP-4 mgpu workaround: fixed in aquamarine >= 0.15.0" && git push
# Nothing else references it; stock behaviour returns immediately.

set -uo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
LOGFILE="$STATE_DIR/dp4-fix.log"
KILL_SWITCH="$STATE_DIR/dp4-fix.off"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-dp4-fix.lock"
OUT="${OMARCHY_DP4_FIX_OUTPUT:-DP-4}"
MODE="${OMARCHY_DP4_FIX_MODE:-1920x1080@240}"
POS="${OMARCHY_DP4_FIX_POSITION:-3000x0}"
SETTLE="${OMARCHY_DP4_FIX_SETTLE:-3}"
FIXED_IN="0.15.0"

mkdir -p "$STATE_DIR" 2>/dev/null
say() {
  printf '%s [%s] %s\n' "$(date -Is)" "$$" "$*" >>"$LOGFILE" 2>/dev/null
  command -v logger >/dev/null 2>&1 && logger -t omarchy-dp4-fix -- "$*" 2>/dev/null
}

# Run the packaged wake FIRST and unconditionally -- never let this shadow stop
# brightness/keyboard restore from happening.
PACKAGED=/usr/share/omarchy/bin/omarchy-system-wake
[[ -x $PACKAGED ]] || PACKAGED=/usr/bin/omarchy-system-wake
if [[ -x $PACKAGED ]]; then "$PACKAGED" "$@"; say "packaged wake exited rc=$?"; else say "packaged wake NOT FOUND"; fi

[[ ${OMARCHY_DP4_FIX:-1} == 0 ]] && { say "disabled via OMARCHY_DP4_FIX=0; exit"; exit 0; }
[[ -e $KILL_SWITCH ]]           && { say "disabled via kill switch $KILL_SWITCH; exit"; exit 0; }
command -v hyprctl >/dev/null 2>&1 || { say "no hyprctl; exit"; exit 0; }
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || { say "no HYPRLAND_INSTANCE_SIGNATURE; exit"; exit 0; }

exec {lk}>"$LOCK"
flock -n "$lk" || { say "another instance holds the lock; exit"; exit 0; }

if command -v vercmp >/dev/null 2>&1; then
  have=$(pacman -Q aquamarine 2>/dev/null | awk '{print $2}')
  if [[ -n $have ]] && (( $(vercmp "$have" "$FIXED_IN") >= 0 )); then
    say "aquamarine $have >= $FIXED_IN -- bug fixed upstream, this workaround is OBSOLETE, remove it"
    exit 0
  fi
fi

hyprctl monitors all -j 2>/dev/null | grep -q "\"name\": *\"$OUT\"" \
  || { say "$OUT not present; exit"; exit 0; }

# Use the instance signature. Do NOT `ls -t /run/user/1000/hypr/*/` -- stale
# instance dirs linger and you will read a previous session's log.
LOG="/run/user/$(id -u)/hypr/$HYPRLAND_INSTANCE_SIGNATURE/hyprland.log"

# Whichever marker appears LAST is the current state. Kept free of the force
# override so the post-repair check below genuinely verifies the outcome.
is_broken() {
  [[ -r $LOG ]] || return 1
  local good bad
  good=$(grep -n 'marked as multigpu, forcing linear' "$LOG" | tail -1 | cut -d: -f1)
  bad=$(grep -n 'Using modifier-less allocation'      "$LOG" | tail -1 | cut -d: -f1)
  say "state: last-good-line=${good:-none} last-bad-line=${bad:-none}"
  (( ${bad:-0} > ${good:-0} ))
}

if [[ ${OMARCHY_DP4_FIX:-1} == force ]]; then
  say "FORCED repair requested"
else
  if is_broken; then say "$OUT IS broken -- repairing"; else say "$OUT healthy -- nothing to do"; exit 0; fi
fi

say "settling ${SETTLE}s before touching the GPU"
sleep "$SETTLE"

say "step 1/2: bitdepth 10 -> BEGIN"
hyprctl eval "hl.monitor({ output = \"$OUT\", mode = \"$MODE\", position = \"$POS\", scale = 1, bitdepth = 10 })" >/dev/null 2>&1
say "step 1/2: bitdepth 10 -> END rc=$?"
sleep 2
say "step 2/2: bitdepth 8 -> BEGIN"
hyprctl eval "hl.monitor({ output = \"$OUT\", mode = \"$MODE\", position = \"$POS\", scale = 1, bitdepth = 8 })" >/dev/null 2>&1
say "step 2/2: bitdepth 8 -> END rc=$?"
sleep 2

if is_broken; then say "RESULT: $OUT still broken -- repair FAILED"; else say "RESULT: $OUT repaired"; fi
say "done"
exit 0
